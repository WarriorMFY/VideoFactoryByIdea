    { "id": "s08", "kind": "img", "img": "img01_candle.png", "dur": 6.0, "k": 1800, "zoom": "pan-l", "chapter": "在电之前",
      "tts": "在电灯出现之前，天黑，就是睡觉的信号。那时候的人，一晚上能睡九个小时——不是因为自律，是因为天黑之后，真的没有别的事可做。" },
    { "id": "s09", "kind": "card", "card": "quote1.png", "dur": 3.2, "k": 1800, "chapter": "在电之前" },

    { "id": "s10", "kind": "img", "img": "img03_1940s.png", "dur": 6.0, "k": 2700, "zoom": "in", "chapter": "白炽灯",
      "tts": "1879年，一盏灯第一次亮过整个夜晚。从此，黑夜变成了白天的延长线。到1942年，美国人平均每晚睡7.9个小时——这已经是开始下降之后的数字。" },
    { "id": "s11", "kind": "info", "img": "img03_1940s.png", "card": "info1.png", "dur": 5.0, "k": 2700, "zoom": "still", "chapter": "白炽灯" },

    { "id": "s12", "kind": "img", "img": "img04_tv.png", "dur": 6.0, "k": 5000, "zoom": "pan-r", "chapter": "荧光与电视",
      "tts": "1954年，电视搬进了客厅。人们不再上床，而是坐在沙发上，等一档节目结束。睡眠，开始被「再看一会儿」切碎。" },
    { "id": "s13", "kind": "img", "img": "img05_fluor.png", "dur": 6.0, "k": 4300, "zoom": "in", "chapter": "荧光与电视",
      "tts": "荧光灯让夜晚变得像白天一样便宜。办公室、厨房、街道——通明的灯火里，睡眠被一点点挤掉。" },
    { "id": "s14", "kind": "card", "card": "chart.png", "dur": 5.0, "k": 5000, "chapter": "荧光与电视",
      "overlays": [ { "text": "−1.1 小时 / 71 年", "style": "num", "at": 0.6, "dur": 3.5 } ] },

    { "id": "s15", "kind": "img", "img": "img07_phone.png", "dur": 6.0, "k": 7500, "zoom": "in", "chapter": "屏幕",
      "tts": "然后是电脑，是互联网，是枕头旁边那块永远亮着的屏幕。2013年，平均睡眠掉到6.8小时。每七个人里，就有一个，睡不到五个小时。" },
    { "id": "s16", "kind": "img", "img": "img06_led.png", "dur": 6.0, "k": 6500, "zoom": "out", "chapter": "屏幕",
      "tts": "我们不是不想睡。是从天黑到天亮，中间再没有一段真正的黑。" },
    { "id": "s17", "kind": "info", "img": "img07_phone.png", "card": "info2.png", "dur": 5.0, "k": 7500, "zoom": "still", "chapter": "屏幕" },

    { "id": "s18", "kind": "img", "img": "img08_dawn.png", "dur": 6.0, "k": 5500, "zoom": "pan-l", "chapter": "所以",
      "tts": "睡前最后一件事是关灯——这可能是这个时代，最便宜、也最有效的一次抵抗。" },
    { "id": "s19", "kind": "card", "card": "quote2.png", "dur": 4.0, "k": 3200, "chapter": "所以" },

    { "id": "s20", "kind": "img", "img": "img09_switch.png", "dur": 4.5, "k": 4000, "zoom": "in", "chapter": "尾声",
      "tts": "今晚，试试把灯，还给黑夜。" },
    { "id": "s21", "kind": "card", "card": "end.png", "dur": 5.0, "k": 6500, "chapter": "尾声" }
