    {
      "start": 0,
      "end": 5.064,
      "text": "Welcome back to the workshop, where we turn raw footage into finished films.",
      "n": 0
    },
    {
      "start": 5.414,
      "end": 10.718,
      "text": "Today I will show you three simple tricks that save about two hours of editing time.",
      "n": 0
    },
    {
      "start": 11.068,
      "end": 16.348,
      "text": "First, always cut on the beat, because rhythm is what keeps the audience awake.",
      "n": 0
    },
    {
      "start": 16.698,
      "end": 22.41,
